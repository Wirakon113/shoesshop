# Copy ไฟล์นี้เป็น `.env` แล้วใส่ค่าจริง (ห้าม commit .env)
# cp .env.example .env   (Windows: copy .env.example .env)

# Gmail SMTP (แนะนำ Google App Password ไม่ใช่รหัสผ่าน Gmail ปกติ)
SMTP_HOST="smtp.gmail.com"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD"
SMTP_PORT="587"
SMTP_FROM_NAME="SHOES SHOP"
